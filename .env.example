# 起動時に読み込む COG の URL。R2 (shi-works バケット) の公開 URL を想定。
# 第1階層はアクセス方法を表す設計なので COG は cog/ に置く。
# 未設定なら何も読み込まず、URL 欄からの指定を待つ。
VITE_COG_URL=https://shi-works.com/cog/city-shizuoka/shizuoka-city-ortho-02m-cog.tif

# パネルに出す出典表記。CC BY のように表示が要るデータでは必ず入れる。
VITE_COG_ATTRIBUTION=出典: 静岡県「VIRTUAL SHIZUOKA 静岡県 中・西部 点群データ」(CC BY 4.0) を加工して作成

# 開発時にローカルの巨大 COG を HTTP Range で配信するディレクトリ。
# 指定すると /local/<相対パス> で読めるようになる（dev サーバー限定）。
LOCAL_RASTER_DIR=
