[
  {
    "AllowedOrigins": [
      "http://127.0.0.1:3000",
      "http://localhost:3000",
      "https://shiwaku.github.io"
    ],
    "AllowedMethods": ["GET", "HEAD"],
    "AllowedHeaders": ["range", "if-match", "if-none-match"],
    "ExposeHeaders": [
      "content-length",
      "content-range",
      "content-type",
      "accept-ranges",
      "etag"
    ],
    "MaxAgeSeconds": 3600
  }
]
